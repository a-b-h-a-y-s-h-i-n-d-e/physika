def rand_array(n: N, μ:ℝ): R[n]:
    return for i:ℕ(n) → μ * eps ~ 𝒩(0.0, 1.0)

def rand_2d_array(n:N, m:N, μ:ℝ): ℝ[n, m]:
    return for i:ℕ(n) → for j:ℕ(m) → μ * eps ~ 𝒩(0.0, 1.0)

def rand_3d_array(m: N, n: N, o: N, μ:ℝ): ℝ[m, n, o]:
    return for i:ℕ(m) → for j:ℕ(n) → for k:N(o) → μ * eps ~ 𝒩(0.0, 1.0)

def L(g: Linear, X: ℝ[n,M], y: ℝ[n]): ℝ:
    ∑(for i:N(n) -> (g(X[i]) - y[i])**2)



class Linear(w: R[M], b: R):
    def λ(x: R[M]) -> R:
        w @ x + b
    def update_params(lr: R, learnable_grads: list):
        for idx:
            this.learnable_params[idx] = this.learnable_params[idx] - lr * learnable_grads[idx]



n: R = 2
M: R = 8


w: R[M] = rand_array(M, 0.1)
b: R = 0.0
g: Linear = Linear(w, b)


X: R[n, M] = rand_2d_array(n, M, 0.1)
y: R[n] = rand_array(n, 0.1)



#L(g, X, y)


epochs: N = 10
lr: R = 0.01

def train(g: Linear, lr: R, epochs: N, X: R[n, M], y: R[M]): Linear:
    for epoch: N(epochs):
        loss = L(g, X, y)
        dg = grad(loss, g.learnable_params)
        g.update_params(lr, dg)
        print(loss)
    return g


train(g, lr, epochs, X, y)


















