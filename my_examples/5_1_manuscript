epochs: N = 10
lr: R = 0.01


def train(g: Linear, lr: R, epochs: N, X: R[B, n, M], y: R[B, n]): Linear:
    for epoch: N(epochs):
        for b: N(B):
            loss = L(g, X, y)
            dg = grad(loss, g.learnable_params)
            g.update_params(lr, dg)
            print(loss)
    return g


train(g, lr, epochs, X, y)



