from tutorials.linear_solve_gaussian_elimination import gaussian_solve, get_2d_array_num_cols, get_2d_array_num_rows, get_1d_array_length, min, max


def rand_2d_array(n:N, m:N, μ:ℝ): ℝ[n, m]:
    return for i:ℕ(n) → for j:ℕ(m) → μ * eps ~ 𝒩(0.0, 1.0)


m, k: ℝ = 2, 4

def lagrangian(x: ℝ[2, 1]): ℝ[1]:
    q: ℝ[1] = x[0]
    qdot: ℝ[1] = x[1]
    return 0.5 * m * qdot * qdot - 0.5 * k * q * q

def tanh(x: ℝ): ℝ:
    return (exp(x) - exp(0.0 - x)) / (exp(x) + exp(0.0 - x))


def mse_loss(pred: ℝ, true: ℝ): R:
    return (pred - true)**2



dataset = create_dataset(50)

train_dataset = dataset[0]
test_dataset = dataset[1]



class LNN(W1: ℝ[H,I], b1: ℝ[H,1], W2: ℝ[1,H], b2: ℝ):
    def λ(x: ℝ[I,1]) → ℝ[d]:
        d: ℕ = I / 2
        L: ℝ[1,1] = W2 @ tanh(W1 @ x + b1) + b2
        dL: ℝ[I,1] = grad(L, x)
        hessian: ℝ[I, I] = zeros(I, I)
        for i:ℕ(I):
            row: ℝ[1, I] = transpose(grad(dL[i], x), 0, 1)
            hessian[i, :] = row
        H_dq_dq: ℝ[d, d] = hessian[d:I, d:I]
        H_q_dq: ℝ[d, d] = hessian[0:d, d:I]
        dL_dq = squeeze(dL[0:d], 1)
        qdot = squeeze(x[d:I], 1)
        b: ℝ[d] = dL_dq - transpose(H_q_dq, 0, 1) @ qdot
        q_ddot: ℝ[d] = gaussian_solve(H_dq_dq, b)
        return q_ddot
    def train(epochs: N, lr: R): R:
        train_dataset_len = len(train_dataset)
        epoch_loss: R = 0
        for idx:N(epochs):
            print(idx)
            epoch_loss: R = 0
            for j:N(train_dataset_len):    
                sample = train_dataset[j]
                x = sample[0]
                true_qddot = sample[1]
                pred = this(x)
                loss = mse_loss(pred, true_qddot)
                epoch_loss += loss
                learnable_grads = grad(loss, this.learnable_params)
                #print(loss)
                #print(learnable_grads)
                this.update_params(lr, learnable_grads)
            epoch_loss = epoch_loss / train_dataset_len
            print(epoch_loss)
        return epoch_loss
    def update_params(lr: R, learnable_grads: R[m]):
        this.W1 = this.W1 - lr * learnable_grads[0]
        this.b1 = this.b1 - lr * learnable_grads[1]
        this.W2 = this.W2 - lr * learnable_grads[2]
        this.b2 = this.b2 - lr * learnable_grads[3]
    def eevaluate() -> R:
        eval_count = len(test_dataset)
        eval_total_error: R = 0
        for eval_idx: N(eval_count):
            eval_sample = test_dataset[eval_idx]
            eval_input = eval_sample[0]
            eval_target = eval_sample[1]
            eval_prediction = this(eval_input)
            eval_error = mse_loss(squeeze(eval_prediction), eval_target)
            eval_total_error += eval_error
        eval_average_error: R = eval_total_error / eval_count
        return eval_average_error    
    def evaluate() -> R:
        test_dataset_len = len(test_dataset)
        total_loss: R = 0
        for i: N(test_dataset_len):
            sample = test_dataset[i]
            x = sample[0]
            true_qddot = sample[1]
            pred = this(x)
            loss = mse_loss(squeeze(pred), true_qddot)
            total_loss += loss
        average_loss: R = total_loss / test_dataset_len
        return average_loss


H: ℕ = 128
I: ℕ = 2
W1: ℝ[H, I] = rand_2d_array(H, I, 0.1)
b1: ℝ[H, 1] = rand_2d_array(H, 1, 0.1)

W2: ℝ[1, H] = rand_2d_array(1, H, 0.1)
b2: ℝ = 0.0


model: LNN = LNN(W1, b1, W2, b2)



epochs: N = 1000
model.train(epochs, 0.0001)


model.evaluate()



