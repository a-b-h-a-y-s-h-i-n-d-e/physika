def get_1d_array_length(x: ℝ[m]): ℝ:
    total: ℝ = 0
    temp: ℝ = 0
    for i:
        temp = x[i]
        total += 1
    return total

def get_list_length(x: list): ℝ:
    total: ℝ = 0
    temp: ℝ = 0
    for i:
        temp = x[i]
        total += 1
    return total


def rand_2d_array(n:ℝ, m:ℝ, μ:ℝ): ℝ[n, m]:
    return for i:ℕ(n) → for j:ℕ(m) → μ * eps ~ 𝒩(0.0, 1.0)

def rand_array(x: ℝ): ℝ[m]:
    t ~ 𝒩(0, 1, x)
    return t


def σ(x: ℝ[a]): ℝ[a]:
    n: ℝ = get_1d_array_length(x)
    result: ℝ[a] = zeros(n)
    for i:ℕ(n):
        result[i] = 1.0 / (1.0 + exp(0.0 - x[i]))
    return result



def argmax(iterable: R[m]): R:
    idx: ℝ = 0
    max_val: ℝ = iterable[0]
    len_iterable: ℝ = get_1d_array_length(iterable)
    for i:ℕ(1, len_iterable):
        if iterable[i] > max_val:
            max_val = iterable[i]
            idx = i
    return idx
def get_1d_array_length(x: ℝ[m]): ℝ:
    total: ℝ = 0
    temp: ℝ = 0
    for i:
        temp = x[i]
        total += 1
    return total

def get_list_length(x: list): ℝ:
    total: ℝ = 0
    temp: ℝ = 0
    for i:
        temp = x[i]
        total += 1
    return total


def rand_2d_array(n:ℝ, m:ℝ, μ:ℝ): ℝ[n, m]:
    return for i:ℕ(n) → for j:ℕ(m) → μ * eps ~ 𝒩(0.0, 1.0)

def rand_array(x: ℝ): ℝ[m]:
    t ~ 𝒩(0, 1, x)
    return t


def σ(x: ℝ[a]): ℝ[a]:
    n: ℝ = get_1d_array_length(x)
    result: ℝ[a] = zeros(n)
    for i:ℕ(n):
