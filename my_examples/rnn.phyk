def get_1d_array_length(x: ℝ[m]): ℝ:
    total: ℝ = 0
    temp: ℝ = 0
    for i:
        temp = x[i]
        total += 1
    return total

def get_list_length(x: list): ℝ:
    total: ℝ = 0
    temp: ℝ = 0
    for i:
        temp = x[i]
        total += 1
    return total


def rand_2d_array(n:ℝ, m:ℝ, μ:ℝ): ℝ[n, m]:
    return for i:ℕ(n) → for j:ℕ(m) → μ * eps ~ 𝒩(0.0, 1.0)

def rand_array(x: ℝ): ℝ[m]:
    t ~ 𝒩(0, 1, x)
    return t


def σ(x: ℝ[a]): ℝ[a]:
    n: ℝ = get_1d_array_length(x)
    result: ℝ[a] = zeros(n)
    for i:ℕ(n):
        result[i] = 1.0 / (1.0 + exp(0.0 - x[i]))
    return result



def argmax(iterable: R[m]): R:
    idx: ℝ = 0
    max_val: ℝ = iterable[0]
    len_iterable: ℝ = get_1d_array_length(iterable)
    for i:ℕ(1, len_iterable):
        if iterable[i] > max_val:
            max_val = iterable[i]
            idx = i
    return idx


dataset = create_dataset(0.9)
train_dataset = dataset[0]
test_dataset = dataset[1]



train_dataset_len = get_1d_array_length(train_dataset)
test_dataset_len = get_1d_array_length(test_dataset)
train_dataset_len
test_dataset_len



# (W @ x) + b
class Linear:
    W: ℝ[out_features, in_features]
    b: ℝ[out_features]
    def λ(x: ℝ[in_features]) → ℝ[out_features]:
        x_len: ℝ = get_1d_array_length(x)
        col: ℝ[x_len, 1] = zeros(x_len, 1)
        col[:, 0] = x
        res: ℝ[out_features, 1] = self.W @ col
        out = res[:, 0] + self.b
        return out
    def update_params(lr: ℝ, learnable_grads: ℝ[m]):
        this.W = this.W - lr * learnable_grads[0]
        this.b = this.b - lr * learnable_grads[1]

def cross_entropy(logits: ℝ[m], label: N): ℝ:
    total: ℝ = 0
    for i:ℕ(18):
        total += exp(logits[i])
    return -logits[label] + log(total)




class RNN:
    hidden_size: ℕ
    in2hidden: Linear
    in2output: Linear
    def λ(x: ℝ[input_size], hidden_state: ℝ[hidden_size]) → ℝ[m], ℝ[n]:
        combined = concat(x, hidden_state)
        hidden = σ(self.in2hidden(combined))
        output = self.in2output(combined)
        return output, hidden
    def init_hidden(): ℝ[m]:
        return zeros(this.hidden_size)
    def train(lr: ℝ, epochs: ℕ): ℝ:
        for epoch:ℕ(epochs):
            print(epoch)
            loss = 0
            for idx:ℕ(train_dataset_len):
                sample = train_dataset[idx]
                name = sample[0]
                target = sample[1]
                hidden_state = this.init_hidden()
                for i:ℕ(len(name)):
                    x = name[i, 0]
                    pred = this(x, hidden_state)
                    output = pred[0]
                    hidden_state = pred[1]
                loss = cross_entropy(output, target)
                grad_first = grad(loss, this.in2hidden.learnable_params)
                grad_second = grad(loss, this.in2output.learnable_params)
                this.in2hidden.update_params(lr, grad_first)
                this.in2output.update_params(lr, grad_second)
            print(loss)
        return loss
    def evaluate(): ℝ:
        correct: ℝ = 0
        for idx:ℕ(test_dataset_len):
            sample = test_dataset[idx]
            name = sample[0]
            print(name)
            target = sample[1]
            hidden_state = this.init_hidden()
            for i:ℕ(len(name)):
                x = name[i, 0]
                pred = this(x, hidden_state)
                output = pred[0]
                hidden_state = pred[1]
            predicted: ℝ = argmax(output)
            target_idx: ℝ = target[0]
            if predicted == target_idx:
                correct += 1
        return correct / test_dataset_len



# input_size = num_letters, output_size = num_lang
input_size: ℝ = 59
output_size: ℝ = 18
hidden_size: ℕ = 128


W1: ℝ[hidden_size, input_size+hidden_size] = rand_2d_array(hidden_size, input_size+hidden_size, 0.01)
b1: ℝ[hidden_size] = rand_array(hidden_size)

W2: ℝ[output_size, input_size+hidden_size] = rand_2d_array(output_size, input_size+hidden_size, 0.01)
b2: ℝ[output_size] = rand_array(output_size)


in2hidden: Linear = Linear(W1, b1)
in2output: Linear = Linear(W2, b2)

rnn: RNN = RNN(hidden_size, in2hidden, in2output)

lr: ℝ = 0.1
epochs: ℕ = 100


#rnn.train(lr, epochs)

rnn.evaluate()




