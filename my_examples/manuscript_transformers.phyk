def rand_3d_array(m: N, n: N, o: N, μ:ℝ): ℝ[m, n, o]:
    return for i:ℕ(m) → for j:ℕ(n) → for k:N(o) → μ * eps ~ 𝒩(0.0, 1.0)

def rand_2d_array(n:N, m:N, μ:ℝ): ℝ[n, m]:
    return for i:ℕ(n) → for j:ℕ(m) → μ * eps ~ 𝒩(0.0, 1.0)

def softmax(x: R[m, n]): R[m, n]:
    results: R[m, n] = zeros(m, n)
    for i: N(m):
        denominator: R = 0.0
        for j: N(n):
            denominator += exp(x[i, j])
        for j: N(n):
            results[i, j] = exp(x[i, j]) / denominator
    return results



class Attention(m: N, n: N, p: N):
    def λ(query: R[m, p], key: R[n, p], value: R[n, p]) -> R[m, p]:
        return softmax(query @ keyᵀ / sqrt(p)) @ value



