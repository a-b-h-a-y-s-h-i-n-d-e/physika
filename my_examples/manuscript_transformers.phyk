D: N = 2
Q: N = 8
K: N = 8

m: N = 2
n: N = 2


query: R[m, D] = rand_2d_array(m, D, 0.1)
key: R[n, D] = rand_2d_array(n, D, 0.1)
value: R[n, D] = rand_2d_array(n, D, 0.1)

q: Linear = Linear(D, Q, rand_2d_array(Q, D, 0.1), zeros(Q))
k: Linear = Linear(D, K, rand_2d_array(Q, D, 0.1), zeros(Q))
v: Linear = Linear(D, K, rand_2d_array(Q, D, 0.1), zeros(Q))


class AttentionHead(D: N, Q: N, K: N, q: Linear, k: Linear, v: Linear):
    def λ(query: R[m, p], key: R[n, p], value: R[n, p]) -> Attention:
        attention: Attention = Attention(m, n, K)
        return attention(q(query), k(key), v(value))

head1: AttentionHead = AttentionHead(D, Q, K, q, k, v)
head2: AttentionHead = AttentionHead(D, Q, K, q, k, v)
head3: AttentionHead = AttentionHead(D, Q, K, q, k, v)

heads: list = [head1, head2, head3]
#head1(query, key, value)


H: N = 3

linear: Linear = Linear(
    H * K, D,
    rand_2d_array(D, H * K, 0.1),
    zeros(D)
)


class MultiHeadAttention(H: N, D: N, Q: N, K: N, heads: list, linear: Linear):
    def λ(query: R[m, D], key: R[n, D], value: R[n, D]) -> R[m, D]:
        results: R[m, H * K] = zeros(m, H * K)
        zero: N = 0
        for i: N(H):
            head = heads[i]
            output: R[m, K] = head(query, key, value)
            if i == zero:
                results = output
            else:
                results = concat(results, output, 1)
        return linear(results)



multi_head: MultiHeadAttention = MultiHeadAttention(H, D, Q, K, heads, linear)
#multi_head(query, key, value)


class PositionEncoding(L: N, M: N, ell: R):
    def λ() -> R[L, M]:
        results: R[L, M] = zeros(L, M)
        for pos: N(L):
            for dim: N(M):
                denominator: R = ell ** ((dim - (dim % 2)) / M)
                phase: R = pos / denominator
                if dim % 2 == 0:
                    results[pos, dim] = sin(phase)
                else:
                    results[pos, dim] = cos(phase)
        return results

encoding: PositionEncoding = PositionEncoding(10, 6, 10000.0)
encoding()



