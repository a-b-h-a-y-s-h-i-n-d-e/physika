def rand_array(n:ℝ, m:ℝ, μ:ℝ): ℝ[n, m]:
    return for i:ℕ(n) → for j:ℕ(m) → μ * eps ~ 𝒩(0.0, 1.0)

def sample_normal1D(x: ℝ): ℝ[m]:
    t ~ 𝒩(0, 1, x)
    return t



size: R = 200
A = rand_array(size, size, 0.01)
b = sample_normal1D(size)
gaussian_solve(A, b)



